DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hireflow"
PORT=5000
NODE_ENV="development"
CORS_ORIGIN="http://localhost:3000"

JWT_SECRET="replace-with-a-long-random-string"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-string"

REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_DB=0
REDIS_KEY_PREFIX="hireflow"

OPEN_AI_API_KEY="replace-with-your-openai-key"
OPEN_AI_MODEL="gpt-4o-mini"
SERPER_API_KEY="replace-with-your-serper-key"

# Used for the cost shown on the Jobs page. The defaults are gpt-4o-mini prices,
# in USD per million tokens, so set these when you change the model.
LLM_INPUT_USD_PER_MILLION=0.15
LLM_OUTPUT_USD_PER_MILLION=0.6

# Leave SMTP_HOST empty to send to a free Ethereal test inbox instead of real people
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# Seconds in an outreach "day". 86400 is real time. Use 20 to show follow-ups in a demo.
OUTREACH_DAY_SECONDS=86400

# The public address of the client, used in booking links sent to candidates
APP_URL="http://localhost:3000"

# Used by `npm run seed` to create the admin account
ADMIN_NAME="Admin"
ADMIN_EMAIL="admin@hireflow.test"
ADMIN_PASSWORD="replace-with-at-least-8-characters"
