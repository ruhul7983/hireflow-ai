// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  // output   = "../generated/prisma"
  // moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  USER
}

model User {
  id         String      @id @default(uuid())
  email      String      @unique
  name       String?
  password   String
  role       Role        @default(USER)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  userTokens UserToken[]

  conversations Conversation[]
  jobs          Job[]
}

model UserToken {
  id           String   @id @default(uuid())
  accessToken  String   @unique @db.Text
  refreshToken String   @unique @db.Text
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  isValid      Boolean  @default(true)
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
}

enum MessageRole {
  USER
  ASSISTANT
}

// Cards are stored as a type plus foreign keys, never as JSON. The UI rebuilds
// each card from the live rows, so a card always shows the current data.
enum CardType {
  JOB_DRAFT
  JOB_CREATED
  SOURCING_PROMPT
  SOURCING_PROGRESS
  CANDIDATE_TABLE
  CANDIDATE_DECISION
  CAMPAIGN_PROPOSAL
  CAMPAIGN_DRAFTS
  CAMPAIGN_PROGRESS
  CAMPAIGN_CHANGE
  QUESTION
  CANDIDATE_REPLY
  MEETING_BOOKED
}

enum RemotePolicy {
  ONSITE
  HYBRID
  REMOTE
}

enum JobStatus {
  OPEN
  CLOSED
}

enum PendingActionType {
  CREATE_JOB
  START_SOURCING
  DECIDE_CANDIDATES
  CREATE_CAMPAIGN
  SEND_CAMPAIGN
  SEND_REPLY
  CHANGE_STATUS
  CHANGE_CAMPAIGN
}

enum CampaignChange {
  PAUSE
  RESUME
  STOP
}

enum PendingActionStatus {
  PENDING
  EXECUTED
  CANCELLED
  FAILED
}

enum CandidateSource {
  SERPER
  CSV
}

enum CandidateStatus {
  SOURCED
  ACCEPTED
  REJECTED
  CONTACTED
  REPLIED
  INTERESTED
  NOT_INTERESTED
  MEETING_BOOKED
  INTERVIEWED
  SHORTLISTED
  HIRED
  UNSUBSCRIBED
}

enum RunStatus {
  QUEUED
  SOURCING
  SCORING
  COMPLETED
  FAILED
}

enum ActivityActor {
  RECRUITER
  AI
  SYSTEM
}

enum ActivityType {
  JOB_CREATED
  SOURCING_STARTED
  SOURCING_FINISHED
  CANDIDATE_STATUS_CHANGED
  CAMPAIGN_CREATED
  CAMPAIGN_APPROVED
  CAMPAIGN_CHANGED
  EMAIL_SENT
  REPLY_RECEIVED
  REPLY_SENT
  MEETING_BOOKED
  AUTO_REPLY_CHANGED
}

enum CampaignStatus {
  DRAFTING
  DRAFT
  SENDING
  PAUSED
  COMPLETED
  CANCELLED
  FAILED
}

enum EmailStatus {
  DRAFT
  APPROVED
  SENDING
  SENT
  FAILED
  STOPPED
}

enum ReplyClassification {
  INTERESTED
  NOT_INTERESTED
  QUESTION
  WANTS_MEETING
  UNSUBSCRIBE
}

enum ReplyDraftStatus {
  PENDING_APPROVAL
  APPROVED
  SENDING
  SENT
  FAILED
  DISCARDED
}

enum LlmPurpose {
  CHAT
  SCORING
  DRAFTING
  REPLY
}

enum QuestionStatus {
  PENDING
  ANSWERED
  CANCELLED
}

enum MeetingStatus {
  DRAFTED
  LINK_SENT
  BOOKED
  COMPLETED
  CANCELLED
}

model Conversation {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId     String?
  job       Job?     @relation(fields: [jobId], references: [id], onDelete: SetNull)
  title     String   @default("New chat")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages       Message[]
  pendingActions PendingAction[]
  jobDrafts      JobDraft[]
  questions      AgentQuestion[]
  llmUsage       LlmUsage[]

  @@index([userId, updatedAt])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           MessageRole
  content        String       @db.Text
  cardType       CardType?
  createdAt      DateTime     @default(now())

  jobDraftId      String?
  jobDraft        JobDraft?       @relation(fields: [jobDraftId], references: [id], onDelete: SetNull)
  jobId           String?
  job             Job?            @relation(fields: [jobId], references: [id], onDelete: SetNull)
  sourcingRunId   String?
  sourcingRun     SourcingRun?    @relation(fields: [sourcingRunId], references: [id], onDelete: SetNull)
  pendingActionId String?
  pendingAction   PendingAction?  @relation(fields: [pendingActionId], references: [id], onDelete: SetNull)
  campaignId      String?
  campaign        Campaign?       @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  questionId      String?
  question        AgentQuestion?  @relation(fields: [questionId], references: [id], onDelete: SetNull)
  replyId         String?
  reply           CandidateReply? @relation(fields: [replyId], references: [id], onDelete: SetNull)
  meetingId       String?
  meeting         Meeting?        @relation(fields: [meetingId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
}

// What the AI extracted, kept apart from Job so that no job exists until the
// recruiter confirms it.
model JobDraft {
  id               String        @id @default(uuid())
  conversationId   String
  conversation     Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  title            String?
  seniority        String?
  location         String?
  salary           String?
  remotePolicy     RemotePolicy?
  mustHaveSkills   String[]
  niceToHaveSkills String[]
  description      String        @db.Text
  sourceUrl        String?
  jobId            String?       @unique
  job              Job?          @relation(fields: [jobId], references: [id], onDelete: SetNull)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  messages       Message[]
  pendingActions PendingAction[]
}

model Job {
  id               String        @id @default(uuid())
  userId           String
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title            String
  seniority        String?
  location         String?
  salary           String?
  remotePolicy     RemotePolicy?
  mustHaveSkills   String[]
  niceToHaveSkills String[]
  description      String        @db.Text
  sourceUrl        String?
  status           JobStatus     @default(OPEN)
  // Off by default, so every reply waits for the recruiter until they choose otherwise
  autoReply        Boolean       @default(false)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  draft          JobDraft?
  conversations  Conversation[]
  messages       Message[]
  pendingActions PendingAction[]
  sourcingRuns   SourcingRun[]
  candidates     Candidate[]
  activityLogs   ActivityLog[]
  campaigns      Campaign[]
  llmUsage       LlmUsage[]

  @@index([userId, createdAt])
}

// Write tools create one of these instead of acting. Only the confirm path runs
// it, so the "confirm before any write" rule is enforced here and not in a prompt.
model PendingAction {
  id             String              @id @default(uuid())
  conversationId String
  conversation   Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  type           PendingActionType
  status         PendingActionStatus @default(PENDING)
  jobDraftId     String?
  jobDraft       JobDraft?           @relation(fields: [jobDraftId], references: [id], onDelete: SetNull)
  jobId          String?
  job            Job?                @relation(fields: [jobId], references: [id], onDelete: Cascade)
  decision       CandidateStatus?
  createdAt      DateTime            @default(now())
  resolvedAt     DateTime?

  // Campaign details wait here until the recruiter confirms the proposal
  campaignId   String?
  campaign     Campaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignName String?
  campaignChange CampaignChange?
  dayOffsets   Int[]
  dailyLimit   Int?
  instructions String?   @db.Text

  replyId String?
  reply   CandidateReply? @relation(fields: [replyId], references: [id], onDelete: Cascade)

  candidates PendingActionCandidate[]
  messages   Message[]

  @@index([conversationId, status])
}

model PendingActionCandidate {
  pendingActionId String
  pendingAction   PendingAction @relation(fields: [pendingActionId], references: [id], onDelete: Cascade)
  candidateId     String
  candidate       Candidate     @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@id([pendingActionId, candidateId])
}

model SourcingRun {
  id             String          @id @default(uuid())
  jobId          String
  job            Job             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  conversationId String
  source         CandidateSource
  status         RunStatus       @default(QUEUED)
  searchQuery    String?
  fileName       String?
  foundCount     Int             @default(0)
  duplicateCount Int             @default(0)
  skippedCount   Int             @default(0)
  scoredCount    Int             @default(0)
  error          String?
  createdAt      DateTime        @default(now())
  finishedAt     DateTime?

  candidates Candidate[]
  messages   Message[]

  @@index([jobId])
}

// Postgres allows many NULLs in a unique index, so candidates missing an email
// or a profile URL still dedupe correctly on the one they have.
model Candidate {
  id            String          @id @default(uuid())
  jobId         String
  job           Job             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  sourcingRunId String?
  sourcingRun   SourcingRun?    @relation(fields: [sourcingRunId], references: [id], onDelete: SetNull)
  source        CandidateSource
  name          String?
  email         String?
  profileUrl    String?
  headline      String?
  location      String?
  snippet       String?         @db.Text
  score         Int?
  scoreReason   String?         @db.Text
  status        CandidateStatus @default(SOURCED)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  pendingActions PendingActionCandidate[]
  activityLogs   ActivityLog[]
  recipients     CampaignRecipient[]
  emails         OutboundEmail[]
  replies        CandidateReply[]
  meetings       Meeting[]

  @@unique([jobId, email])
  @@unique([jobId, profileUrl])
  @@index([jobId, status])
  @@index([jobId, score])
}

model ActivityLog {
  id          String           @id @default(uuid())
  jobId       String
  job         Job              @relation(fields: [jobId], references: [id], onDelete: Cascade)
  candidateId String?
  candidate   Candidate?       @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  actor       ActivityActor
  type        ActivityType
  fromStatus  CandidateStatus?
  toStatus    CandidateStatus?
  summary     String
  createdAt   DateTime         @default(now())

  @@index([jobId, createdAt])
}

model Campaign {
  id             String         @id @default(uuid())
  jobId          String
  job            Job            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  conversationId String
  name           String
  status         CampaignStatus @default(DRAFTING)
  dailyLimit     Int            @default(50)
  instructions   String?        @db.Text
  senderName     String
  error          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  steps          CampaignStep[]
  recipients     CampaignRecipient[]
  messages       Message[]
  pendingActions PendingAction[]

  @@index([jobId])
}

model CampaignStep {
  id         String   @id @default(uuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  position   Int
  dayOffset  Int

  emails OutboundEmail[]

  @@unique([campaignId, position])
}

model CampaignRecipient {
  id          String    @id @default(uuid())
  campaignId  String
  campaign    Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  stoppedAt   DateTime?

  @@unique([campaignId, candidateId])
}

model OutboundEmail {
  id             String       @id @default(uuid())
  campaignStepId String
  campaignStep   CampaignStep @relation(fields: [campaignStepId], references: [id], onDelete: Cascade)
  candidateId    String
  candidate      Candidate    @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  subject        String
  body           String       @db.Text
  status         EmailStatus  @default(DRAFT)
  dueAt          DateTime?
  sentAt         DateTime?
  messageId      String?
  previewUrl     String?
  error          String?
  createdAt      DateTime     @default(now())

  replies CandidateReply[]

  // Guarantees no candidate can ever receive the same step twice
  @@unique([campaignStepId, candidateId])
  @@index([status, dueAt])
}

model CandidateReply {
  id              String               @id @default(uuid())
  candidateId     String
  candidate       Candidate            @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  conversationId  String
  // The email being answered, kept for the reply's subject and threading
  outboundEmailId String?
  outboundEmail   OutboundEmail?       @relation(fields: [outboundEmailId], references: [id], onDelete: SetNull)
  body            String               @db.Text
  classification  ReplyClassification?
  draftBody       String?              @db.Text
  draftStatus     ReplyDraftStatus?
  autoSent        Boolean              @default(false)
  sentAt          DateTime?
  messageId       String?
  previewUrl      String?
  error           String?
  receivedAt      DateTime             @default(now())

  messages       Message[]
  pendingActions PendingAction[]
  meeting        Meeting?

  @@index([candidateId, receivedAt])
}

// The token is the only thing on the public booking page's URL, so it must be
// unguessable. The link works once the recruiter's email has gone out.
model Meeting {
  id             String          @id @default(uuid())
  candidateId    String
  candidate      Candidate       @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  conversationId String
  replyId        String?         @unique
  reply          CandidateReply? @relation(fields: [replyId], references: [id], onDelete: SetNull)
  token          String          @unique
  startsAt       DateTime?
  status         MeetingStatus   @default(DRAFTED)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  messages Message[]

  @@index([candidateId])
  @@index([startsAt])
}

// One row per AI call. Chat before a job exists has only a conversation, and is
// moved onto the job when the recruiter confirms it.
model LlmUsage {
  id             String        @id @default(uuid())
  jobId          String?
  job            Job?          @relation(fields: [jobId], references: [id], onDelete: SetNull)
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  purpose        LlmPurpose
  model          String
  inputTokens    Int
  outputTokens   Int
  createdAt      DateTime      @default(now())

  @@index([jobId])
  @@index([conversationId])
}

// A paused LangGraph run waiting on the recruiter. The options are rows so the
// buttons survive a refresh and the question can be answered only once.
model AgentQuestion {
  id             String         @id @default(uuid())
  conversationId String
  conversation   Conversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  threadId       String
  key            String
  status         QuestionStatus @default(PENDING)
  answerLabel    String?
  createdAt      DateTime       @default(now())
  resolvedAt     DateTime?

  options  AgentQuestionOption[]
  messages Message[]

  @@index([conversationId, status])
}

model AgentQuestionOption {
  id          String        @id @default(uuid())
  questionId  String
  question    AgentQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  label       String
  value       String
  description String?
  recommended Boolean       @default(false)
  position    Int

  @@unique([questionId, position])
}

// LangGraph checkpoints. Stored as bytes so paused runs survive a restart without
// a JSON column, which the official Postgres saver would need.
model AgentCheckpoint {
  threadId           String
  checkpointNs       String   @default("")
  checkpointId       String
  parentCheckpointId String?
  dataType           String
  data               Bytes
  metadataType       String
  metadata           Bytes
  createdAt          DateTime @default(now())

  @@id([threadId, checkpointNs, checkpointId])
}

model AgentCheckpointWrite {
  threadId     String
  checkpointNs String @default("")
  checkpointId String
  taskId       String
  idx          Int
  taskPath     String @default("")
  channel      String
  valueType    String
  value        Bytes

  @@id([threadId, checkpointNs, checkpointId, taskId, idx])
}
